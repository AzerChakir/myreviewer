# Normalise line endings so the Linux/VM tooling cannot be broken by a
# Windows contributor. The deployment scripts (bootstrap_vm.sh) and the
# Dockerfile are executed on the Azure VM - CRLF in them causes
# "bad interpreter: /bin/bash^M" and hard-to-diagnose failures.

* text=auto eol=lf

# Shell + config consumed on the VM or in CI
*.sh    text eol=lf
*.bash  text eol=lf
*.conf  text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows launchers must keep CRLF so PowerShell/cmd are happy
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Never rewrite these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.pem   binary
*.p12   binary
*.pfx   binary

# Lockfiles and generated bundles
package-lock.json  text eol=lf
