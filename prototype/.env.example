# ─────────────────────────────────────────────────────────────────────────
# PR Decomposer — environment configuration
# Copy this file to `.env` and fill in your values. The `.env` file is
# gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────

# ── LLM provider: NVIDIA NIM (free hosted OpenAI-compatible endpoints) ────
# Get a free key at https://build.nvidia.com → "API keys" (format: nvapi-...)
# The pipeline runs real LLM calls whenever this is set. Leave it empty and
# the API/CLI will fail fast with a clear message — mock responses are an
# explicit dev/test opt-in only (dashboard checkbox, cli.py --mock, seed --mock).
NIM_API_KEY=

# Leave as-is unless you self-host a NIM / vLLM server (base URL must end in /v1)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model. We start with a single model; add others deliberately from the
# NVIDIA NIM catalog by hardcoding them in NIM_MODELS (comma-separated).
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: extra model ids offered in the dashboard model selector
# (comma-separated; self-hosted vLLM/NIM or account-specific models).
#NIM_MODELS=

# Optional sampling controls
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# ── GitHub App (the "Connect your GitHub" flow) ──────────────────────────────
# This product is a GitHub App like CodeRabbit: users click "Connect GitHub",
# GitHub redirects them to install your App, and from then on the server uses
# the App's own credentials + per-installation access tokens to read PRs and
# post comments. No OAuth app, no user PAT.
#
# To create the App: https://github.com/settings/apps/new
#   - Webhook URL:  https://<your-domain>/webhook
#   - Setup URL:    https://<your-domain>/webhook   <-- same URL, see below
#   - Webhook secret: anything long + random → paste into GITHUB_WEBHOOK_SECRET
#   - Permissions: Pull requests (read+write), Issues (read+write),
#     Contents (read), Metadata (read)
#   - Events to subscribe: Pull requests, Issue comment, Installation,
#     Installation repositories
#   - App URL / homepage + a logo are required by GitHub.
#
# Why the Webhook URL and Setup URL are identical: GitHub POSTs events to the
# Webhook URL, and after a user installs your App it sends their *browser* to
# the Setup URL with ?setup_action=install&installation_id=... appended. This
# service exposes POST /webhook (events) and GET /webhook (install redirect) on
# the same path, so one URL covers both.
#
# The URL must be publicly reachable over https with a trusted certificate.
# A raw VM IP with a self-signed cert will be rejected by GitHub.
#
# After creating it, download the private key (.pem), save it somewhere safe
# (e.g. prototype/private-key.pem) and point GITHUB_PRIVATE_KEY_PATH at it.
GITHUB_APP_ENABLED=1
GITHUB_APP_ID=123456
#GITHUB_APP_SLUG=   # optional; auto-fetched from GitHub when unset
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_BOT_USERNAME=pr-decomposer[bot]
GITHUB_PRIVATE_KEY_PATH=prototype/private-key.pem

# Optional legacy fallback for CLI live tests / one-off analysis only.
# The dashboard and webhook never need this.
#GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# ── Deployment (Azure VM behind nginx) ──────────────────────────────────────
# The public base URL of this deployment. One URL serves everything: the
# dashboard (/), the REST API (/api/*) and the GitHub App webhook (/webhook).
#
# This must be the PUBLIC https URL, not localhost — it is what you register
# as both the App's "Webhook URL" and its "Setup URL", and what the post-install
# redirect sends users to. https:// is also mandatory: GitHub refuses to deliver
# webhooks over plain http or with a self-signed certificate.
APP_URL=https://pr-decomposer.example.com

# Where the GitHub App's own health probe should be reachable. Optional; the
# endpoint itself is always served at /health on the same host as APP_URL.
#HEALTHCHECK_URL=https://pr-decomposer.example.com/health

# Writable directory for runtime data (installations/reports/app tokens).
# In Docker this is the mounted volume (/app/data) — set it in
# docker-compose.yml. Losing it loses your installations and reports.
DATA_DIR=./data

# ── Local development only ─────────────────────────────────────────────────
# When running the Angular dev server on :4200 against a backend on :8000,
# point APP_URL back at the dev server so the post-install redirect works.
# APP_URL=http://localhost:4200