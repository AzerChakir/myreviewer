+++ b/users/uploads.py
@@ -0,0 +1,18 @@
+import os
+import uuid
+from pathlib import Path
+
+from django.core.files.storage import default_storage
+
+
+def store_avatar(file_obj, user):
+    ext = Path(file_obj.name).suffix
+    key = f"avatars/{user.id}/{uuid.uuid4().hex}{ext}"
+    default_storage.save(key, file_obj)
+    user.avatar_key = key
+    user.save(update_fields=["avatar_key"])
+    return key
+
+
+def avatar_url(user):
+    if not user.avatar_key:
+        return None
+    return default_storage.url(user.avatar_key)
